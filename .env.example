# ===== 配置模板（复制为 .env.dev / .env.prod 后填写；勿提交真实密码）=====
# 优先级：真实环境变量 > 本文件 > 代码内默认值（internal/config）
# APP_ENV 决定后端默认加载哪个文件（dev→.env.dev，prod→.env.prod）；也可用 ENV_FILE 指定具体路径
APP_ENV=dev

# ---- 服务 ----
SERVER_PORT=8090            # 后端监听端口
SERVER_MODE=debug           # gin 模式：debug / release
LOG_LEVEL=info              # 日志级别：debug / info / warn / error
APP_BASE_URL=               # 对外访问地址，用于拼接文件 URL、短链接与官网下载二维码

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # 必填
POSTGRES_DBNAME=anxuncloud
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=                 # 必填，生产至少 32 位随机串
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# ---- CORS ----
CORS_ALLOW_ORIGINS=*        # 逗号分隔多个来源

# ---- 初始超管账号（仅首次 seed 生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # 必填，bcrypt 入库；生产使用默认弱密码会打印醒目警告
ADMIN_NAME=系统管理员

# ---- 微信小程序（appid/secret 缺失或 MOCK=true 时为 mock 登录，仅开发联调）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

# ---- uniPush 2.0 App 推送（个推 V2；三要素任一为空即推送关闭，站内通知不受影响）----
# DCloud 开发者中心开通 uniPush 2.0 后到个推后台（dev.getui.com）取密钥；
# 厂商离线通道（华为/小米/OPPO/vivo 等）在个推后台「应用配置-厂商通道」配置
UNIPUSH_APPID=
UNIPUSH_APPKEY=
UNIPUSH_MASTERSECRET=

# ---- 上传 ----
UPLOAD_MODE=local           # local 本地存储 / oss 阿里云直传 / cos 腾讯云 COS
UPLOAD_LOCAL_DIR=uploads
UPLOAD_MAX_FILE_SIZE=20971520

# ---- 阿里云 OSS（UPLOAD_MODE=oss 时必填）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ROLE_ARN=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_EXPIRE_SECONDS=3600

# ---- 腾讯云 COS（UPLOAD_MODE=cos 时必填；当前为服务端签名直写，STS 直传为后续优化）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=                 # 形如 bucketname-1234567890
COS_REGION=                 # 如 ap-guangzhou
COS_EXPIRE_SECONDS=3600

# ---- 水印字体（需支持中文的 TTF）----
WATERMARK_FONT_PATH=/app/fonts/NotoSansSC.ttf
WATERMARK_LOGO_PATH=/app/assets/logo.png

# ---- 生产 SPA 托管（前端 dist 目录；为空不启用）----
SPA_DIST_PATH=
