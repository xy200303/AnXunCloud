# ===== 配置模板（复制为 .env.dev / .env.prod 后填写；勿提交真实密码）=====
# 优先级：真实环境变量 > 本文件 > 代码内默认值（internal/config）
# APP_ENV 决定后端默认加载哪个文件（dev→.env.dev，prod→.env.prod）；也可用 ENV_FILE 指定具体路径
APP_ENV=dev

# ---- 服务 ----
PI_SERVER_PORT=8090            # 后端监听端口
PI_SERVER_MODE=debug           # gin 模式：debug / release
PI_LOG_LEVEL=info              # 日志级别：debug / info / warn / error
PI_APP_BASE_URL=               # 对外访问地址，用于拼接文件 URL 与 OSS 回调地址

# ---- PostgreSQL ----
PI_POSTGRES_HOST=127.0.0.1
PI_POSTGRES_PORT=5432
PI_POSTGRES_USER=postgres
PI_POSTGRES_PASSWORD=          # 必填
PI_POSTGRES_DBNAME=anxuncloud
PI_POSTGRES_SSLMODE=disable

# ---- Redis ----
PI_REDIS_ADDR=127.0.0.1:6379
PI_REDIS_PASSWORD=
PI_REDIS_DB=0

# ---- JWT ----
PI_JWT_SECRET=                 # 必填，生产至少 32 位随机串
PI_JWT_ACCESS_TTL=2h
PI_JWT_REFRESH_TTL=168h

# ---- CORS ----
PI_CORS_ALLOW_ORIGINS=*        # 逗号分隔多个来源

# ---- 初始超管账号（仅首次 seed 生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # 必填，bcrypt 入库；生产使用默认弱密码会打印醒目警告
ADMIN_NAME=系统管理员

# ---- 微信小程序（appid/secret 缺失或 MOCK=true 时为 mock 登录，仅开发联调）----
PI_WECHAT_APPID=
PI_WECHAT_SECRET=
PI_WECHAT_MOCK=true

# ---- 上传 ----
PI_UPLOAD_MODE=dev             # dev 本地存储 / oss 阿里云直传
PI_UPLOAD_LOCAL_DIR=uploads
PI_UPLOAD_MAX_FILE_SIZE=20971520

# ---- 阿里云 OSS（UPLOAD_MODE=oss 时必填）----
PI_OSS_ACCESS_KEY_ID=
PI_OSS_ACCESS_KEY_SECRET=
PI_OSS_ROLE_ARN=
PI_OSS_BUCKET=
PI_OSS_ENDPOINT=
PI_OSS_EXPIRE_SECONDS=3600

# ---- 水印字体（需支持中文的 TTF）----
PI_WATERMARK_FONT_PATH=/app/fonts/NotoSansSC.ttf
PI_WATERMARK_LOGO_PATH=/app/assets/logo.png

# ---- 生产 SPA 托管（前端 dist 目录；为空不启用）----
SPA_DIST_PATH=
