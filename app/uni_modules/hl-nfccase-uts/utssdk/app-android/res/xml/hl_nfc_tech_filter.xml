<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      覆盖你需要支持的 NFC 技术类型（Type 1-5 / Mifare / IsoDep / NfcA/B/F/V 等）
      说明：
      - TECH_DISCOVERED 必须配合 tech-list 才能匹配
      - 这里列得越全，后台碰卡命中我们 NfcDispatchActivity 的概率越高
    -->

    <!-- NDEF: NFC Forum Type 1-5 常见都会暴露 Ndef / NdefFormatable -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>

    <!-- Mifare -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>
    <tech-list>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>

    <!-- ISO-DEP (ISO14443-4) -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
    </tech-list>

    <!-- NFC-A/B/F/V -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>
    <tech-list>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>
    <tech-list>
        <tech>android.nfc.tech.NfcF</tech>
    </tech-list>
    <tech-list>
        <tech>android.nfc.tech.NfcV</tech>
    </tech-list>
</resources>
