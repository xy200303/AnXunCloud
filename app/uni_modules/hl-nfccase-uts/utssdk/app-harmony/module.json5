{
  "module": {
    "name": "uni_modules__hl_nfccase_uts",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.NFC_TAG",
        "usedScene": {
          "when": "inuse"
        },
        "reason": "$string:permission_nfc_reason"
      }
    ]
  }
}
