# Penpot 部署环境变量模板：复制为 penpot.env 后填写，切勿提交真实值
# cp penpot.env.example penpot.env && chmod 600 penpot.env

# 对外访问地址（反代后的 HTTPS 域名，结尾不要带斜杠）
PENPOT_PUBLIC_URI=https://penpot.example.com

# 主机暴露端口（由反代转发到这里）
PENPOT_HTTP_PORT=9001

# 会话与令牌签名密钥：必须替换，生成方式 openssl rand -hex 32
PENPOT_SECRET_KEY=change-me-openssl-rand-hex-32

# 数据库口令：必须替换，建议 24 位以上随机串
PENPOT_DB_PASSWORD=change-me-strong-db-password

# 数据库用户（默认 penpot 即可）
PENPOT_DB_USER=penpot

# 注册策略：默认关闭自助注册（邀请制），需要开放时改成 enable-registration
PENPOT_FRONTEND_FLAGS=enable-login-with-password disable-registration enable-mcp enable-smtp
PENPOT_BACKEND_FLAGS=enable-login-with-password disable-registration disable-email-verification disable-telemetry enable-mcp enable-smtp

# —— 邮件（邀请/找回密码）——
# 注意：发件人变量是 PENPOT_SMTP_DEFAULT_FROM / _REPLY_TO，
# 不是 PENPOT_SMTP_FROM；腾讯企业邮要求发件人 = SMTP 认证账号，否则 501。
# PENPOT_SMTP_ENABLED=true
# PENPOT_SMTP_HOST=smtp.exmail.qq.com
# PENPOT_SMTP_PORT=465
# PENPOT_SMTP_SSL=true
# PENPOT_SMTP_TLS=false
# PENPOT_SMTP_USERNAME=system@example.com
# PENPOT_SMTP_PASSWORD=客户端专用密码
# PENPOT_SMTP_DEFAULT_FROM=Penpot <system@example.com>
# PENPOT_SMTP_DEFAULT_REPLY_TO=system@example.com
